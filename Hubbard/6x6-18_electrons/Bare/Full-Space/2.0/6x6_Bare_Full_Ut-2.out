diff --git a/exachem/cc/ducc/ducc-t_ccsd.cpp b/exachem/cc/ducc/ducc-t_ccsd.cpp
index 4b468c1..1ff0e5b 100644
--- a/exachem/cc/ducc/ducc-t_ccsd.cpp
+++ b/exachem/cc/ducc/ducc-t_ccsd.cpp
@@ -10,0 +11 @@
+#include "tamm/eigen_utils.hpp"
@@ -154,0 +156,12 @@ void DUCCInternal<T>::DUCC_T_CCSD_Driver(ChemEnv& chem_env, ExecutionContext& ec
+  // Dense execution context used both for the norm verification below and for
+  // the dense-tensor result printing further down in this function.
+  ExecutionContext ec_dense{ec.pg(), DistributionKind::dense,
+                            MemoryManagerKind::ga}; // create ec_dense once
+
+  // Print norms of original T1/T2 operators
+  const auto t1_full_norm   = tamm::norm(t1);
+  const auto t2_full_norm   = tamm::norm(t2);
+
+  qfstr << "Norm of T1 (Full): " << t1_full_norm << std::endl;
+  qfstr <<  "Norm of T2 (Full): " << t2_full_norm << std::endl;
+
@@ -161,0 +175,60 @@ void DUCCInternal<T>::DUCC_T_CCSD_Driver(ChemEnv& chem_env, ExecutionContext& ec
+  const auto t1_ext_norm   = tamm::norm(t1);
+  const auto t2_ext_norm   = tamm::norm(t2);
+
+  auto [maxt1ext, maxblockid1, maxcoord1] = tamm::max_element(t1);
+  auto [mint1ext, minblockid1, mincoord1] = tamm::min_element(t1);
+  auto [maxt2ext, maxblockid2, maxcoord2] = tamm::max_element(t2);
+  auto [mint2ext, minblockid2, mincoord2] = tamm::min_element(t2);
+  
+  qfstr << "Norm of T1 (Ext): " << t1_ext_norm << std::endl;
+  qfstr << "Norm of T2 (Ext): " << t2_ext_norm << std::endl;
+  // qfstr << std::endl;
+  qfstr << "Max abs of T1 (Ext): " << maxt1ext << std::endl;
+  qfstr << "Min abs of T1 (Ext): " << mint1ext << std::endl;
+  qfstr << "Max abs of T2 (Ext): " << maxt2ext << std::endl;
+  qfstr << "Min abs of T2 (Ext): " << mint2ext << std::endl;
+  // qfstr << std::endl;
+  qfstr << "Norm of T1 (Int): " << sqrt(t1_full_norm * t1_full_norm - t1_ext_norm * t1_ext_norm) << std::endl;
+  qfstr << "Norm of T2 (Int): " << sqrt(t2_full_norm * t2_full_norm - t2_ext_norm * t2_ext_norm) << std::endl;
+
+  // --- Verification: recompute norm of T1 (Ext) / T2 (Ext) two independent ways ---
+
+  // (1) Explicit self-contraction into a scalar tensor.
+  // At this point T1/T2 have already had their T_int blocks zeroed out, so
+  // contracting the full p1/h1 (p1,p2/h1,h2) ranges against themselves only
+  // picks up the surviving T_ext values.
+  Tensor<T> t1_dot{};
+  Tensor<T> t2_dot{};
+  sch.allocate(t1_dot, t2_dot).execute();
+  // clang-format off
+  sch(t1_dot() = t1(p1, h1) * t1(p1, h1))
+     (t2_dot() = t2(p1, p2, h1, h2) * t2(p1, p2, h1, h2))
+     .execute(ex_hw);
+  // clang-format on
+  const auto t1_ext_norm_contract = std::sqrt(get_scalar(t1_dot));
+  const auto t2_ext_norm_contract = std::sqrt(get_scalar(t2_dot));
+  free_tensors(t1_dot, t2_dot);
+
+  // (2) Gather T1/T2 into local, dense Eigen tensors and manually loop over
+  // every element to accumulate the sum of squares.
+  const auto t1_eigen = tamm_to_eigen_tensor<T, 2>(t1);
+  T          t1_sumsq = 0;
+  for(Eigen::Index i = 0; i < t1_eigen.dimension(0); i++)
+    for(Eigen::Index j = 0; j < t1_eigen.dimension(1); j++)
+      t1_sumsq += t1_eigen(i, j) * t1_eigen(i, j);
+  const auto t1_ext_norm_eigen = std::sqrt(t1_sumsq);
+
+  const auto t2_eigen = tamm_to_eigen_tensor<T, 4>(t2);
+  T          t2_sumsq = 0;
+  for(Eigen::Index i = 0; i < t2_eigen.dimension(0); i++)
+    for(Eigen::Index j = 0; j < t2_eigen.dimension(1); j++)
+      for(Eigen::Index k = 0; k < t2_eigen.dimension(2); k++)
+        for(Eigen::Index l = 0; l < t2_eigen.dimension(3); l++)
+          t2_sumsq += t2_eigen(i, j, k, l) * t2_eigen(i, j, k, l);
+  const auto t2_ext_norm_eigen = std::sqrt(t2_sumsq);
+
+  qfstr << "Norm of T1 (Ext, Contraction): " << t1_ext_norm_contract << std::endl;
+  qfstr << "Norm of T2 (Ext, Contraction): " << t2_ext_norm_contract << std::endl;
+  qfstr << "Norm of T1 (Ext, Eigen Loop): " << t1_ext_norm_eigen << std::endl;
+  qfstr << "Norm of T2 (Ext, Eigen Loop): " << t2_ext_norm_eigen << std::endl;
+
@@ -398,2 +471 @@ void DUCCInternal<T>::DUCC_T_CCSD_Driver(ChemEnv& chem_env, ExecutionContext& ec
-  ExecutionContext ec_dense{ec.pg(), DistributionKind::dense,
-                            MemoryManagerKind::ga}; // create ec_dense once
+  // ec_dense was created earlier, alongside the T1/T2 norm verification above.
