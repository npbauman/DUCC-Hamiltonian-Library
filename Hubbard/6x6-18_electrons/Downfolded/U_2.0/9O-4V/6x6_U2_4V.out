diff --git a/exachem/cc/ducc/qflow-t_ccsd.cpp b/exachem/cc/ducc/qflow-t_ccsd.cpp
index a037583..f3ef85a 100644
--- a/exachem/cc/ducc/qflow-t_ccsd.cpp
+++ b/exachem/cc/ducc/qflow-t_ccsd.cpp
@@ -572,0 +573,216 @@ void ducc_qflow_driver(ExecutionContext& ec, ChemEnv& chem_env) {
+  
+  // START COVOS READING HERE!
+  {
+    // Ion-Ion Energy
+    const std::string covos_dir    = chem_env.get_files_dir();
+    const std::string ion_ion_file = covos_dir + "/ion_ion.dat";
+    if(!fs::exists(ion_ion_file))
+      tamm_terminate("[COVOS ERROR]: could not find " + ion_ion_file);
+
+    std::ifstream ion_ion_in(ion_ion_file);
+    double        covos_ion_ion_energy = 0.0;
+    ion_ion_in >> covos_ion_ion_energy;
+    chem_env.scf_context.nuc_repl_energy = covos_ion_ion_energy;
+
+    if(rank == 0) {
+      std::cout << "[COVOS] Overwriting ion-ion repulsion energy with value read from "
+                << ion_ion_file << ": " << std::setprecision(15) << covos_ion_ion_energy
+                << std::endl;
+    }
+
+    // One-Electron Integrals
+    // d_f1 is the spin-orbital Fock matrix, ordered occ_alpha | occ_beta | virt_alpha | virt_beta.
+    // Since d_f1 is a TAMM tensor (block-addressable, not element-addressable), it is filled via
+    // a full Eigen matrix and then converted back.
+    const std::string one_electron_file = covos_dir + "/one_electron_integrals.dat";
+    if(!fs::exists(one_electron_file))
+      tamm_terminate("[COVOS ERROR]: could not find " + one_electron_file);
+
+    if(rank == 0) {
+      std::ifstream oe_in(one_electron_file);
+      TAMM_SIZE     file_nocc = 0, file_nvirt = 0;
+      size_t        nelements = 0;
+      oe_in >> file_nocc >> file_nvirt >> nelements;
+      if(file_nocc != nocc_orb || file_nvirt != nvirt_orb)
+        tamm_terminate("[COVOS ERROR]: " + one_electron_file +
+                       " orbital counts (occ=" + std::to_string(file_nocc) +
+                       ", virt=" + std::to_string(file_nvirt) + ") do not match expected (occ=" +
+                       std::to_string(nocc_orb) + ", virt=" + std::to_string(nvirt_orb) + ")");
+
+      // Maps a 1-based spatial orbital index to its (alpha, beta) spin-orbital indices.
+      auto spatial_to_spin = [&](TAMM_SIZE p) -> std::pair<size_t, size_t> {
+        if(p <= nocc_orb) {
+          size_t idx = p - 1;
+          return {idx, chem_env.sys_data.n_occ_alpha + idx};
+        }
+        size_t idx = p - nocc_orb - 1;
+        return {chem_env.sys_data.nocc + idx,
+                chem_env.sys_data.nocc + chem_env.sys_data.n_vir_alpha + idx};
+      };
+
+      Matrix d_f1_eig = tamm_to_eigen_matrix(d_f1);
+      d_f1_eig.setZero();
+
+      for(size_t k = 0; k < nelements; ++k) {
+        TAMM_SIZE p = 0, q = 0;
+        T         val = 0.0;
+        oe_in >> p >> q >> val;
+
+        auto [p_a, p_b] = spatial_to_spin(p);
+        auto [q_a, q_b] = spatial_to_spin(q);
+
+        d_f1_eig(p_a, q_a) = val;
+        d_f1_eig(q_a, p_a) = val;
+        d_f1_eig(p_b, q_b) = val;
+        d_f1_eig(q_b, p_b) = val;
+      }
+
+      eigen_to_tamm_tensor(d_f1, d_f1_eig);
+      std::cout << "[COVOS] Overwrote one-electron integrals (d_f1) with values read from "
+                << one_electron_file << std::endl;
+    }
+
+    // Two-Electron Integrals
+    // Values are Mulliken (chemist) notation (pq|rs) over spatial orbitals, printed with 8-fold
+    // permutational symmetry. They are expanded into a full spin-orbital chemist-notation array,
+    // combined into the physicist-notation antisymmetrized integral <pq||rs> = (pr|qs) - (ps|qr)
+    // (matching the convention used by exachem::cholesky_2e::setupV2()), and converted to the
+    // TAMM tensor chem_env.cd_context.d_v2.
+    const std::string two_electron_file = covos_dir + "/two_electron_integrals.dat";
+    if(!fs::exists(two_electron_file))
+      tamm_terminate("[COVOS ERROR]: could not find " + two_electron_file);
+
+    Tensor<T>& d_v2 = chem_env.cd_context.d_v2;
+    d_v2            = Tensor<T>{{MO, MO, MO, MO}, {2, 2}};
+    sch.allocate(d_v2).execute();
+
+    // if(rank == 0) {
+      std::ifstream te_in(two_electron_file);
+      TAMM_SIZE     file_nocc = 0, file_nvirt = 0;
+      size_t        nelements = 0;
+      te_in >> file_nocc >> file_nvirt >> nelements;
+      if(file_nocc != nocc_orb || file_nvirt != nvirt_orb)
+        tamm_terminate("[COVOS ERROR]: " + two_electron_file +
+                       " orbital counts (occ=" + std::to_string(file_nocc) +
+                       ", virt=" + std::to_string(file_nvirt) + ") do not match expected (occ=" +
+                       std::to_string(nocc_orb) + ", virt=" + std::to_string(nvirt_orb) + ")");
+
+      // Flat spatial-orbital chemist-notation array with 8-fold permutational symmetry.
+      std::vector<T> v_chem(total_orbitals * total_orbitals * total_orbitals * total_orbitals,
+                            0.0);
+      auto           idx4 = [total_orbitals](size_t a, size_t b, size_t c, size_t d) {
+        return ((a * total_orbitals + b) * total_orbitals + c) * total_orbitals + d;
+      };
+      auto set_8fold = [&](size_t p, size_t q, size_t r, size_t s, T val) {
+        v_chem[idx4(p, q, r, s)] = val;
+        v_chem[idx4(q, p, r, s)] = val;
+        v_chem[idx4(p, q, s, r)] = val;
+        v_chem[idx4(q, p, s, r)] = val;
+        v_chem[idx4(r, s, p, q)] = val;
+        v_chem[idx4(s, r, p, q)] = val;
+        v_chem[idx4(r, s, q, p)] = val;
+        v_chem[idx4(s, r, q, p)] = val;
+      };
+
+      for(size_t k = 0; k < nelements; ++k) {
+        TAMM_SIZE p = 0, q = 0, r = 0, s = 0;
+        T         val = 0.0;
+        te_in >> p >> q >> r >> s >> val;
+        set_8fold(p - 1, q - 1, r - 1, s - 1, val);
+      }
+
+      // Maps a 0-based spin-orbital index to its (spatial index, spin) pair (0 = alpha, 1 = beta).
+      const auto& sd        = chem_env.sys_data;
+      auto        spin_info = [&](size_t so) -> std::pair<size_t, int> {
+        if(so < sd.n_occ_alpha) return {so, 0};
+        if(so < sd.nocc) return {so - sd.n_occ_alpha, 1};
+        if(so < sd.nocc + sd.n_vir_alpha) return {nocc_orb + (so - sd.nocc), 0};
+        return {nocc_orb + (so - sd.nocc - sd.n_vir_alpha), 1};
+      };
+
+      // Chemist-notation spin-orbital integral (ab|cd); zero unless spin(a)=spin(b), spin(c)=spin(d).
+      auto chem_spin = [&](size_t a, size_t b, size_t c, size_t d) -> T {
+        auto [asp, aspin] = spin_info(a);
+        auto [bsp, bspin] = spin_info(b);
+        if(aspin != bspin) return 0.0;
+        auto [csp, cspin] = spin_info(c);
+        auto [dsp, dspin] = spin_info(d);
+        if(cspin != dspin) return 0.0;
+        return v_chem[idx4(asp, bsp, csp, dsp)];
+      };
+
+      const size_t n_so = chem_env.sys_data.nmo;
+      Tensor4D     d_v2_eig(n_so, n_so, n_so, n_so);
+      for(size_t p = 0; p < n_so; ++p)
+        for(size_t q = 0; q < n_so; ++q)
+          for(size_t r = 0; r < n_so; ++r)
+            for(size_t s = 0; s < n_so; ++s)
+              d_v2_eig(p, q, r, s) = chem_spin(p, r, q, s) - chem_spin(p, s, q, r);
+
+      // Sanity check #1: HF electronic energy from the bare one-electron Hamiltonian (d_f1 still
+      // holds h at this point, before it is overwritten with the Fock operator below) and the
+      // antisymmetrized two-electron integrals: E = sum_i h_ii + 1/2 sum_ij <ij||ij>
+      Matrix       h_eig     = tamm_to_eigen_matrix(d_f1);
+      const size_t n_occ_so  = sd.nocc;
+      T            h_trace   = 0.0;
+      for(size_t i = 0; i < n_occ_so; ++i) h_trace += h_eig(i, i);
+      T v2_docc = 0.0;
+      for(size_t i = 0; i < n_occ_so; ++i)
+        for(size_t j = 0; j < n_occ_so; ++j) v2_docc += d_v2_eig(i, j, i, j);
+
+      const T e1_elec  = h_trace + 0.5 * v2_docc;
+      const T e1_total = e1_elec + chem_env.scf_context.nuc_repl_energy;
+
+      // Build the Fock operator: f_pq = h_pq + sum_i <pi||qi>.
+      Matrix f_eig = h_eig;
+      for(size_t p = 0; p < n_so; ++p)
+        for(size_t q = 0; q < n_so; ++q) {
+          T sum = 0.0;
+          for(size_t i = 0; i < n_occ_so; ++i) sum += d_v2_eig(p, i, q, i);
+          f_eig(p, q) += sum;
+        }
+
+      // Sanity check #2: same electronic energy, from the Fock operator and the antisymmetrized
+      // two-electron integrals: E = sum_i f_ii - 1/2 sum_ij <ij||ij>
+      T f_trace = 0.0;
+      for(size_t i = 0; i < n_occ_so; ++i) f_trace += f_eig(i, i);
+      const T e2_elec  = f_trace - 0.5 * v2_docc;
+      const T e2_total = e2_elec + chem_env.scf_context.nuc_repl_energy;
+
+      eigen_to_tamm_tensor(d_v2, d_v2_eig);
+      eigen_to_tamm_tensor(d_f1, f_eig); // overwrite d_f1: bare Hamiltonian -> Fock operator
+
+      std::cout << "[COVOS] Overwrote two-electron integrals (d_v2) with values read from "
+                << two_electron_file << std::endl;
+      std::cout << "[COVOS] Overwrote d_f1 with the Fock operator built from h and <ij||ij>"
+                << std::endl;
+      std::cout << std::setprecision(12);
+      std::cout << "[COVOS] Sanity SCF energy from h + 0.5*sum<ij||ij>: " << e1_total
+                << " (electronic = " << e1_elec << ", sum h_ii = " << h_trace
+                << ", 0.5*sum<ij||ij> = " << 0.5 * v2_docc << ")" << std::endl;
+      std::cout << "[COVOS] Sanity SCF energy from f - 0.5*sum<ij||ij>: " << e2_total
+                << " (electronic = " << e2_elec << ", sum f_ii = " << f_trace
+                << ", 0.5*sum<ij||ij> = " << 0.5 * v2_docc << ")" << std::endl;
+      chem_env.scf_context.hf_energy = e2_total;
+    // }
+    // ec.pg().barrier();
+
+    // Split the full antisymmetrized d_v2 tensor into the occ/virt blocks used downstream
+    // (i,j,k,l = occupied via h3,h4,h5,h6; a,b,c,d = virtual via p1,p2,p3,p4), mirroring how
+    // these blocks are normally built from Cholesky vectors via
+    // exachem::cholesky_2e::setupV2Tensors().
+    // clang-format off
+    sch(v2tensors.v2ijab(h3, h4, p1, p2) = d_v2(h3, h4, p1, p2))
+       (v2tensors.v2iajb(h3, p1, h4, p2) = d_v2(h3, p1, h4, p2))
+       (v2tensors.v2ijka(h3, h4, h5, p1) = d_v2(h3, h4, h5, p1))
+       (v2tensors.v2ijkl(h3, h4, h5, h6) = d_v2(h3, h4, h5, h6))
+       (v2tensors.v2iabc(h3, p1, p2, p3) = d_v2(h3, p1, p2, p3))
+       (v2tensors.v2abcd(p1, p2, p3, p4) = d_v2(p1, p2, p3, p4))
+       .execute(ex_hw);
+    // clang-format on
+    if(rank == 0) {
+      std::cout << "[COVOS] Split d_v2 into v2tensors blocks (ijab, iajb, ijka, ijkl, iabc, abcd)"
+                << std::endl;
+    }
+
+  }
