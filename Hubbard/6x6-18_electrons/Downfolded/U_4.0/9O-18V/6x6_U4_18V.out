+  // Print norms of original T1/T2 operators
+  const auto t1_full_norm   = tamm::norm(t1);
+  const auto t2_full_norm   = tamm::norm(t2);
+
+  qfstr << "Norm of T1 (Full): " << t1_full_norm << std::endl;
+  qfstr <<  "Norm of T2 (Full): " << t2_full_norm << std::endl;
