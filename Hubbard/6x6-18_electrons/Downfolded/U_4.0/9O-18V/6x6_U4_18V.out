diff --git a/exachem/cc/scripts/hamiltonian_extractor/hamiltonian_data.py b/exachem/cc/scripts/hamiltonian_extractor/hamiltonian_data.py
index 2dcddc8..f60df5a 100644
--- a/exachem/cc/scripts/hamiltonian_extractor/hamiltonian_data.py
+++ b/exachem/cc/scripts/hamiltonian_extractor/hamiltonian_data.py
@@ -5 +4,0 @@ import numpy as np
-from numpy import linalg as LA
@@ -10 +9 @@ class HamiltonianData:
-    
+
@@ -24,2 +23,2 @@ class HamiltonianData:
-        
-        # Integral matrices
+
+        # Integral matrices (spatial orbital basis)
@@ -29,5 +28 @@ class HamiltonianData:
-        
-        # Processed data
-        self.scf_energy = None
-        # self.orbital_energies = None
-        
+
@@ -36 +31 @@ class HamiltonianData:
-        
+
@@ -38,2 +33,4 @@ class HamiltonianData:
-        """Compute Hartree-Fock and core energies."""
-        # Compute the Hartree-Fock energy
+        """Compute the Hartree-Fock (SCF) energy from the extracted integrals."""
+        # Safety guard: treat missing energy shift as zero
+        if self.energy_shift is None:
+            self.energy_shift = 0.0
@@ -46 +42,0 @@ class HamiltonianData:
-
@@ -48 +44 @@ class HamiltonianData:
-        """Form the Fock operator matrix."""
+        """Form the closed-shell Fock operator matrix (spatial orbital basis)."""
@@ -55,3 +51,44 @@ class HamiltonianData:
-        
-        # # Compute orbital energies
-        # self.orbital_energies, _ = LA.eig(self.fock)
+
+    def spin_orbital_integrals(self):
+        """Build the spin-orbital Fock matrix and antisymmetrized two-electron
+        integrals used by post-HF backends (built-in MP2, miniccpy).
+
+        Spin orbitals are interleaved alpha/beta (index 2p = alpha p,
+        index 2p+1 = beta p), which is the layout expected by miniccpy.
+        Since the underlying data is a closed-shell (RHF) Hamiltonian, the
+        alpha and beta blocks are identical copies of the spatial-orbital
+        quantities.
+
+        Returns:
+            fockso (2*n_orb, 2*n_orb): spin-orbital Fock matrix, block diagonal
+            g (2*n_orb, ...): antisymmetrized two-electron integrals <pq||rs>
+            occ (slice): occupied spin-orbital slice
+            virt (slice): virtual spin-orbital slice
+        """
+        if self.fock is None:
+            self.compute_fock_matrix()
+
+        n_orb = self.n_orbitals
+        n_so = 2 * n_orb
+        n_occ = self.n_occ_alpha + self.n_occ_beta
+
+        fockso = np.zeros((n_so, n_so))
+        fockso[0::2, 0::2] = self.fock
+        fockso[1::2, 1::2] = self.fock
+
+        # Spin-orbital integrals in chemist notation (pq|rs), same-spin blocks
+        # only (cross-spin chemist integrals vanish for real orbitals).
+        stei = np.zeros((n_so, n_so, n_so, n_so))
+        stei[0::2, 0::2, 0::2, 0::2] = self.two_body
+        stei[1::2, 1::2, 1::2, 1::2] = self.two_body
+        stei[0::2, 0::2, 1::2, 1::2] = self.two_body
+        stei[1::2, 1::2, 0::2, 0::2] = self.two_body
+
+        # Antisymmetrize: <pq||rs> = <pq|rs> - <pq|sr>
+        #   <pq|rs> = (pr|qs) = stei.transpose(0, 2, 1, 3)
+        #   <pq|sr> = (ps|qr) = stei.transpose(0, 2, 3, 1)
+        g = stei.transpose(0, 2, 1, 3) - stei.transpose(0, 2, 3, 1)
+
+        occ = slice(0, n_occ)
+        virt = slice(n_occ, n_so)
+        return fockso, g, occ, virt
