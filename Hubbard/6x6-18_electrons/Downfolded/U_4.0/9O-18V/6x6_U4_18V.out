-                elif ln_segments[:6] == ["Number", "of", "active", "occupied", "beta", "="]:
-                    data.n_occ_beta = int(ln_segments[6])
-                elif ln_segments[:6] == ["Number", "of", "active", "virtual", "alpha", "="]:
