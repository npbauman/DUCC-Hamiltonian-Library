-                    data.geometry['atoms'] = []
-                    data.geometry['symmetry'] = "C1"
-                elif ln_segments[:4] == ["Nuclear", "repulsion", "energy", "="]:
-                    data.coulomb_repulsion = {
-                        'units': 'hartree',
